// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Calendar days are stored as UTC midnight of the farm-local date
// (see lib/dates.ts) so a record never drifts across a day boundary.

model Pond {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  species      String?
  // Start of the current culture cycle ("0 Month" in the spreadsheet).
  stockedAt    DateTime? @map("stocked_at")
  stockedCount Int?      @map("stocked_count")
  // Planned length of a culture cycle, stocking to harvest.
  cycleMonths  Int       @default(8) @map("cycle_months")
  // Feed conversion ratio used to estimate biomass from feed consumed.
  assumedFcr   Float     @default(1.35) @map("assumed_fcr")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")

  dailyLogs DailyLog[]
  samplings Sampling[]
  imports   ImportBatch[]
  cycles    PondCycle[]

  @@map("ponds")
}

// A finished culture cycle. The running cycle lives on the pond itself
// (stockedAt / stockedCount); closing it moves those here with a snapshot
// of its totals and leaves the pond empty until it is restocked.
model PondCycle {
  id           Int      @id @default(autoincrement())
  pondId       Int      @map("pond_id")
  number       Int
  stockedAt    DateTime @map("stocked_at")
  stockedCount Int?     @map("stocked_count")
  endedAt      DateTime @map("ended_at")
  // "harvested" or "lost" (the whole stock died).
  outcome      String
  harvestKg    Float?   @map("harvest_kg")
  // Fish harvested, or fish lost in the final event for a loss.
  fishCount    Int?     @map("fish_count")
  cause        String?
  note         String?
  feedKg       Float    @map("feed_kg")
  feedCostRm   Float    @map("feed_cost_rm")
  deadCount    Int      @map("dead_count")
  createdAt    DateTime @default(now()) @map("created_at")

  pond Pond @relation(fields: [pondId], references: [id], onDelete: Cascade)

  @@unique([pondId, number])
  @@map("pond_cycles")
}

model FeedType {
  id         Int     @id @default(autoincrement())
  code       String  @unique
  packSizeKg Float   @map("pack_size_kg")
  pricePerKg Float   @map("price_per_kg")
  active     Boolean @default(true)

  dailyLogs      DailyLog[]
  stockMovements StockMovement[]

  @@map("feed_types")
}

// One row per pond per day, mirroring a row of the monthly feed log sheet.
model DailyLog {
  id            Int      @id @default(autoincrement())
  pondId        Int      @map("pond_id")
  date          DateTime
  feedTypeId    Int?     @map("feed_type_id")
  bags          Float    @default(0)
  // Snapshots taken when the log is saved so later price or pack-size
  // changes do not rewrite history.
  feedKg        Float    @default(0) @map("feed_kg")
  feedCostRm    Float    @default(0) @map("feed_cost_rm")
  deadCount     Int      @default(0) @map("dead_count")
  note          String?
  recordedBy    String?  @map("recorded_by")
  source        String   @default("app")
  importBatchId Int?     @map("import_batch_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  pond        Pond         @relation(fields: [pondId], references: [id], onDelete: Cascade)
  feedType    FeedType?    @relation(fields: [feedTypeId], references: [id])
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([pondId, date])
  @@index([feedTypeId])
  @@index([importBatchId])
  @@map("daily_logs")
}

// Average body weight from weighing a sample of fish.
model Sampling {
  id            Int      @id @default(autoincrement())
  pondId        Int      @map("pond_id")
  date          DateTime
  avgWeightKg   Float    @map("avg_weight_kg")
  sampleSize    Int?     @map("sample_size")
  note          String?
  recordedBy    String?  @map("recorded_by")
  source        String   @default("app")
  importBatchId Int?     @map("import_batch_id")
  createdAt     DateTime @default(now()) @map("created_at")

  pond        Pond         @relation(fields: [pondId], references: [id], onDelete: Cascade)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([pondId, date])
  @@index([importBatchId])
  @@map("samplings")
}

// Farm-level feed store. "count" is a physical stocktake that resets the
// running balance; "delivery" adds bags on top of it.
model StockMovement {
  id         Int      @id @default(autoincrement())
  feedTypeId Int      @map("feed_type_id")
  date       DateTime
  kind       String
  bags       Float
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  feedType FeedType @relation(fields: [feedTypeId], references: [id], onDelete: Cascade)

  @@index([feedTypeId, date])
  @@map("stock_movements")
}

model ImportBatch {
  id         Int      @id @default(autoincrement())
  pondId     Int      @map("pond_id")
  fileName   String   @map("file_name")
  importedAt DateTime @default(now()) @map("imported_at")
  // JSON: parsed totals and reconciliation findings, shown on the pond page.
  summary    String
  findings   String

  pond      Pond       @relation(fields: [pondId], references: [id], onDelete: Cascade)
  dailyLogs DailyLog[]
  samplings Sampling[]

  @@index([pondId])
  @@map("import_batches")
}
